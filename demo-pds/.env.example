# Public hostname. The PDS serves https://$PDS_HOSTNAME and its DID is did:web:$PDS_HOSTNAME.
PDS_HOSTNAME=pds.demo.getair.space
PDS_PORT=3000

# Handles handed out to visitors: demo-1a2b3c4d.demo.getair.space.
PDS_SERVICE_HANDLE_DOMAINS=.demo.getair.space

# Persistent volume. SQLite databases, actor stores and blobs all live under here.
PDS_DATA_DIRECTORY=/data
PDS_BLOBSTORE_DISK_LOCATION=/data/blobs

# The real directory, so did:plc identities resolve for everyone.
PDS_DID_PLC_URL=https://plc.directory

# Invite codes are required unless this is explicitly 0. Mint one with `pnpm invite`.
PDS_INVITE_REQUIRED=1

# No SMTP config, so no confirmation mail is sent and no address is ever verified.

# 1 MB per blob, instead of the 5 MB default.
PDS_BLOB_UPLOAD_LIMIT=1000000

# Nobody is importing a repo into a demo PDS.
PDS_ACCEPTING_REPO_IMPORTS=0

# Secrets. Generate with `openssl rand --hex 32` (or `--hex 16` for the admin password).
PDS_JWT_SECRET=
PDS_DPOP_SECRET=
PDS_ADMIN_PASSWORD=
PDS_PLC_ROTATION_KEY_K256_PRIVATE_KEY_HEX=

# Branding on the OAuth screens. Not used by the demo, which signs in with a password.
PDS_SERVICE_NAME=airspace demo
PDS_HOME_URL=https://getair.space

LOG_ENABLED=1
LOG_LEVEL=info
